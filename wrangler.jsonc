{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "star-trek-china-video",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  "env": {
    "preview": {
      "name": "star-trek-china-video-preview"
    },
    "production": {
      "name": "star-trek-china-video"
    }
  }
}
